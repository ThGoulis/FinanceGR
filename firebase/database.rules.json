{
  "rules": {
    ".read": false,
    ".write": false,
    "userRooms": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null && root.child('rooms/' + $roomId + '/members/' + auth.uid).exists()",
        ".write": false,
        "metadata": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/members/' + auth.uid).exists()",
          ".write": false
        },
        "members": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/members/' + auth.uid).exists()",
          ".write": false
        },
        "updatedAt": {
          ".write": "auth != null && (root.child('rooms/' + $roomId + '/members/' + auth.uid + '/role').val() === 'owner' || root.child('rooms/' + $roomId + '/members/' + auth.uid + '/role').val() === 'editor')",
          ".validate": "newData.isNumber()"
        },
        "deviceProfiles": {
          "$deviceId": {
            ".write": "auth != null && (root.child('rooms/' + $roomId + '/members/' + auth.uid + '/role').val() === 'owner' || root.child('rooms/' + $roomId + '/members/' + auth.uid + '/role').val() === 'editor')",
            ".validate": "newData.hasChildren(['iv', 'ct']) && newData.child('iv').isString() && newData.child('ct').isString() && newData.child('ct').val().length <= 15000"
          }
        },
        "sharedState": {
          ".write": "auth != null && (root.child('rooms/' + $roomId + '/members/' + auth.uid + '/role').val() === 'owner' || root.child('rooms/' + $roomId + '/members/' + auth.uid + '/role').val() === 'editor')",
          ".validate": "newData.val() === null || (newData.hasChildren(['iv', 'ct']) && newData.child('iv').isString() && newData.child('ct').isString() && newData.child('ct').val().length <= 500000)"
        },
        "txs": {
          "$txId": {
            ".write": "auth != null && (root.child('rooms/' + $roomId + '/members/' + auth.uid + '/role').val() === 'owner' || root.child('rooms/' + $roomId + '/members/' + auth.uid + '/role').val() === 'editor')",
            ".validate": "newData.val() === null || (newData.hasChildren(['iv', 'ct']) && newData.child('iv').isString() && newData.child('ct').isString() && newData.child('ct').val().length <= 25000)"
          }
        }
      }
    },
    "roomIndex": {
      ".read": false,
      ".write": false
    },
    "adminAuditLog": {
      ".read": false,
      ".write": false
    },
    "adminTelemetry": {
      ".read": false,
      ".write": false
    },
    "userEntitlements": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
